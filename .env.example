# Credenciales de prueba (NO usar en producción)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ciclox_db

SECRET_KEY=test-secret-key-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Orígenes permitidos por CORS (separados por coma). "*" solo para desarrollo.
CORS_ORIGINS=*

# Usuario de prueba que se crea automáticamente al iniciar la app
SEED_TEST_USER_NOMBRES=Usuario de prueba
SEED_TEST_USER_USUARIO=test
SEED_TEST_USER_PASSWORD=test1234
